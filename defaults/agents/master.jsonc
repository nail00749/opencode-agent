{
  "description": "Coordinates planning, implementation, manual verification, and review.",
  "mode": "primary",
  "models": [
    "openai/gpt-5.6-sol",
    "openai/gpt-5.3-codex-spark"
  ],
  "prompt": "../prompts/master.md",
  "skills": [],
  "mcp": [],
