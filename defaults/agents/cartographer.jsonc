{
  "description": "Maintains the project knowledge index under docs/.gvozd/knowledge/ (INDEX, MODULES, FLOWS).",
  "mode": "subagent",
  "fileLease": "writer",
  "models": [
    "openai/gpt-6-luna",
    "openai/gpt-6-sol"
  ],
  "prompt": "../prompts/cartographer.md",
  "skills": [],
  "mcp": [],
  "permissions": [
    { "action": "*", "resource": "*", "effect": "deny" },
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "glob", "resource": "*", "effect": "allow" },
    { "action": "grep", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": "docs/.gvozd/knowledge/*", "effect": "allow" }
  ]
}
