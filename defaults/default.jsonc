{
  // Built-in baseline. Project overrides beyond $schema and descriptions of
  // existing agents require an external, content-bound project trust token.
  "defaultAgent": "master",
  "jev": {
    "enabled": false,
    "provider": "typesafe",
    "baseUrl": "https://api.typesafe.ai",
    "model": "jev-latest",
    "apiKeyEnv": "TYPESAFE_API_KEY",
    "allowedAgents": ["master", "planner", "researcher"]
  },
  // Built-in team roster lives in defaults/agents/ (including extreme);
  // this map holds only layer overrides, never the roster itself.
  "agents": {}
}
