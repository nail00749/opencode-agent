{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "// Generated by agent-gvozd sync. Do not edit this file directly.",
  "x-agent-gvozd-schema-version": 3,
  "$id": "https://example.invalid/agent-gvozd.schema.json",
  "title": "Agent Gvozd configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "defaultAgent": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$" },
    "agentsDirectory": { "type": "string", "minLength": 1 },
    "lease": { "$ref": "#/$defs/lease" },
    "jev": { "$ref": "#/$defs/jev" },
    "agents": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$" },
      "additionalProperties": { "$ref": "#/$defs/agent" }
    }
  },
  "$defs": {
    "jev": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional Jev structured evaluation integration. API keys stay in environment variables.",
      "properties": {
        "enabled": { "type": "boolean" },
        "provider": { "enum": ["typesafe", "vercel"] },
        "baseUrl": { "type": "string", "format": "uri", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "apiKeyEnv": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
        "allowedAgents": {
          "type": "array",
          "maxItems": 255,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$" }
        }
      }
    },
    "lease": {
      "type": "object",
      "additionalProperties": false,
      "description": "File lease lifetime tuning (minutes).",
      "properties": {
        "reservationTtlMinutes": { "type": "integer", "minimum": 1, "maximum": 1440 },
        "activeTtlMinutes": { "type": "integer", "minimum": 1, "maximum": 1440 },
        "shellEscalation": { "enum": ["ask", "deny"] }
      }
    },
    "permission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "resource", "effect"],
      "properties": {
        "action": { "type": "string", "minLength": 1 },
        "resource": { "type": "string", "minLength": 1 },
        "effect": { "enum": ["allow", "ask", "deny"] }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string", "minLength": 1 },
        "mode": { "enum": ["primary", "subagent", "all"] },
        "models": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[^/#\\s]+/[^#\\s]+(?:#[^#\\s]+)?$"
          }
        },
        "prompt": { "type": "string", "minLength": 1 },
        "skills": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "mcp": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "permissions": {
          "type": "array",
          "items": { "$ref": "#/$defs/permission" }
        },
        "fileLease": {
          "description": "File coordination role enforced by agent-gvozd.",
          "enum": ["coordinator", "writer", "readonly"]
        },
        "disabled": { "type": "boolean" }
      }
    }
  }
}
