{
  "name": "@nail00749/agent-gvozd",
  "version": "0.3.8",
  "description": "A globally configured, permission-aware agent team for OpenCode V2",
  "license": "MIT",
  "keywords": [
    "opencode",
    "agents",
    "multi-agent",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nail00749/opencode-agent.git"
  },
  "homepage": "https://github.com/nail00749/opencode-agent#readme",
  "bugs": {
    "url": "https://github.com/nail00749/opencode-agent/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "bun@1.4.2",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./server": "./dist/index.js",
    "./tui": "./dist/tui.js"
  },
  "bin": {
    "gvozd": "dist/cli.js"
  },
  "files": [
    "dist",
    "defaults",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun run ./scripts/build.ts",
    "lint": "oxlint",
    "sync": "bun run ./src/cli/index.ts sync",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "verify:sync": "bun run ./scripts/verify-sync.ts",
    "verify:package": "bun run ./scripts/verify-package.ts",
    "verify:live": "bun run ./scripts/live-opencode-compat.ts",
    "prepublishOnly": "bun run test:unit && bun run lint && bun run typecheck && bun run build && bun run verify:sync && bun run verify:package && bun run test:e2e",
    "test:unit": "bun test --path-ignore-patterns \"**/package-smoke.test.ts\"",
    "test:e2e": "bun test src/cli/package-smoke.test.ts",
    "publish:fast": "bun run test:unit && bun run typecheck && bun run build && bun run verify:package && npm publish --ignore-scripts"
  },
  "dependencies": {
    "@clack/prompts": "1.8.0",
    "@opencode/plugin": "2.0.2",
    "@typesafe-ai/sdk": "^0.6.0",
    "ai": "^7.0.107",
    "jsonc-parser": "3.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "oxlint": "^1.83.0",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.0.2",
    "@opentui/core": "^0.5.11",
    "@opentui/solid": "^0.5.11",
    "solid-js": ">=1.9.12"
  }
}
