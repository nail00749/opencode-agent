{
  "name": "@nail00749/agent-gvozd",
  "version": "0.1.1",
  "description": "A globally configured, permission-aware agent team for OpenCode V2",
  "license": "MIT",
  "keywords": ["opencode", "agents", "multi-agent", "cli"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nail00749/opencode-agent.git"
  },
  "homepage": "https://github.com/nail00749/opencode-agent#readme",
  "bugs": {
    "url": "https://github.com/nail00749/opencode-agent/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.12.0"
  },
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./server": "./dist/index.js"
  },
  "bin": {
    "gvozd": "dist/cli.js"
  },
  "files": [
    "dist",
    "defaults",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun run ./scripts/build.ts",
    "sync": "bun run ./src/cli.ts sync",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "verify:package": "bun run ./scripts/verify-package.ts",
    "prepublishOnly": "bun run build && bun test && bun run typecheck && bun run verify:package"
  },
  "dependencies": {
    "@clack/prompts": "1.8.0",
    "@opencode/plugin": "0.0.0-beta-19425",
    "jsonc-parser": "3.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "typescript": "7.0.2"
  }
}
